{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Pacific/Auckland",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "linuxserver.io images use date-style tags, not semver",
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release versions pinned as ARG in the Containerfile",
      "managerFilePatterns": ["/^Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "automerge": true,
  "platformAutomerge": false
}
