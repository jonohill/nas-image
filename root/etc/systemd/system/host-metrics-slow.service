[Unit]
Description=Write SMART and bootc metrics for node_exporter

[Service]
Type=oneshot
Environment=TZ=Pacific/Auckland
# A failed unit at boot triggers a greenboot rollback, and a missing metric
# shows on the dashboard as a stale collector time.
ExecStart=-/usr/local/sbin/host-metrics smart
ExecStart=-/usr/local/sbin/host-metrics bootc
