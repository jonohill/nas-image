[Unit]
Description=Forget, prune and check the jotta rustic repo
Requires=zfs-tank.service download-secrets.service
After=zfs-tank.service download-secrets.service
# Both maintenance units start with offpeak.target, and each loads a full
# index. Run them in sequence so their memory peaks don't add up.
After=rustic-maintain-nas.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=TZ=Pacific/Auckland
# Otherwise rustic logs every progress bar to the journal each 10 s. JSON
# progress would mix several rustic commands into one figure.
Environment=RUSTIC_NO_PROGRESS=true
EnvironmentFile=/run/rustic/env
ExecCondition=/usr/local/sbin/rustic-due nas-maintain-jotta 27
ExecCondition=/usr/local/sbin/rustic-idle nas-tank-data nas-copy
ExecStart=/usr/local/sbin/rustic-job nas-maintain-jotta /usr/local/sbin/rustic-maintain-jotta
ExecStartPost=-/usr/local/sbin/rustic-inventory jotta
