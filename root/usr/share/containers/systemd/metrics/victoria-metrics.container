[Unit]
Description=VictoriaMetrics
Requires=zfs-ssd.service
After=zfs-ssd.service network-online.target
Wants=network-online.target
# A failed unit at boot triggers a greenboot rollback, so keep restarting
# rather than parking the unit as failed.
StartLimitIntervalSec=0

[Container]
Image=docker.io/victoriametrics/victoria-metrics:v1.153.0
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
# Image is logically bound, so bootc keeps it in the additional store above
Pull=never
ContainerName=victoria-metrics
Network=host
Environment=TZ=Pacific/Auckland
Volume=/var/mnt/ssd/data/victoria-metrics:/storage:Z
Volume=/usr/share/containers/systemd/metrics/scrape.yml:/etc/victoria-metrics/scrape.yml:ro
# The HTTP API has no auth and can delete series, so it stays on loopback.
Exec=-storageDataPath=/storage -retentionPeriod=5y -httpListenAddr=127.0.0.1:8428 -promscrape.config=/etc/victoria-metrics/scrape.yml

[Service]
Restart=always
RestartSec=30
ExecStartPre=/usr/bin/mkdir -p /var/mnt/ssd/data/victoria-metrics

[Install]
WantedBy=multi-user.target
